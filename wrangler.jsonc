// Cloudflare-Worker "firemap" (statische Assets) — Deploy per `npx wrangler deploy`
// aus GitHub Actions (Secrets: CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID).
// Das Ausgabeverzeichnis dist/ wird im Workflow-Schritt zusammengestellt.
{
  "name": "firemap",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist"
  }
}
